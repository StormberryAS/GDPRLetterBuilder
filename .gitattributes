# GitHub's language bar counts what people write, not what a tool generates. These files are
# generated, so they are marked as such and left out of the statistics (and their diffs are
# collapsed by default on GitHub).
#
# app.js and src/*.js are compiled from ts/ by tools/build-ts.sh (29 October 2026); edit the
# TypeScript.
/app.js linguist-generated=true
/src/*.js linguist-generated=true
# android/web-overlay/android-bridge.js, the script the Android app injects into the page, is compiled
# from android-bridge.ts beside it by tools/build-ts.sh; edit the TypeScript.
/android/web-overlay/android-bridge.js linguist-generated=true
# gate.js, the first-run notice, is compiled from ts/gate.ts by tools/build-ts.sh (0.0.2). ts/gate.ts
# itself is written by build-gates.py at the root of the GitHub folder, shared by every Labs app, so
# it is generated too; neither is edited here.
/gate.js linguist-generated=true
/ts/gate.ts linguist-generated=true
# The goldens are written by tests/update-goldens.ts from the letter templates.
/tests/goldens/*.txt linguist-generated=true
/tests/goldens/followup/*.txt linguist-generated=true
