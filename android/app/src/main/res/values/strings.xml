<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toasts: Android shows at most two lines (about 70 characters on a phone), so each message
         stays at 66 characters or fewer (CheckLink's rule, decision Q4 of 11 October 2026). -->
    <string name="app_name">GDPRLetterBuilder</string>
    <!-- The share sheet's heading on Android 9 and earlier; later versions show their own. -->
    <string name="share_chooser">Share</string>
    <string name="file_saved">Saved.</string>
    <string name="file_save_failed">The file could not be saved. Try Save again.</string>
    <string name="no_app_for_link">No app on this device can open that link.</string>
    <string name="no_email_app">No email app on this device. Copy or save the letter instead.</string>
    <string name="email_refused">This email draft could not be handed to an email app.</string>
    <string name="no_calendar_app">No calendar app on this device. Save the reminder instead.</string>
    <string name="calendar_failed">The reminder could not be opened in a calendar app.</string>
    <string name="print_failed">Printing could not start on this device.</string>
    <string name="webview_too_old">Parts of this app need a newer Android System WebView. Update it.</string>
    <string name="page_crashed">The app stopped and reloaded, so its fields are empty again.</string>
    <!-- Back on the letter when something is typed (E3-1), if the page cannot ask in its own
         dialog: the same words as android-bridge.js uses there. -->
    <string name="close_question">Close the app? What you have typed will be lost.</string>
    <string name="close_close">Close</string>
    <string name="close_cancel">Cancel</string>
    <!-- Print job names. Android's print screen shows them, and Save as PDF suggests them as the
         file name, so they are neutral: never a company name (OUT-2). -->
    <string name="print_job_letter">GDPRLetterBuilder letter</string>
    <string name="print_job_follow_up">GDPRLetterBuilder follow-up letter</string>
    <string name="print_job_timeline">GDPRLetterBuilder timeline</string>
</resources>
